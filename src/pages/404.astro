---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
---
<PageLayout title="Lạc vào đám mây" description="Trang này chưa có ở góc trời của Duy.">
  <Container>
    <p class="eyebrow">404 / LẠC MỘT CHÚT</p>
    <h1 class="page-title">Hình như đi quá đám mây rồi.</h1>
    <p class="mt-5 mb-8">Trang bạn tìm chưa có ở đây. Quay lại ngồi chơi nhé?</p>
    <Link href="/">← Về góc nhỏ</Link>
  </Container>
</PageLayout>
