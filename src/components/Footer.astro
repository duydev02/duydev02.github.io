---
import Container from "@components/Container.astro";
import BackToTop from "@components/BackToTop.astro";
---
<footer>
  <Container>
    <div class="footer-top"><BackToTop /></div>
    <div class="footer-line">
      <p>© {new Date().getFullYear()} Duy <span aria-hidden="true">·</span> vẫn đang nghịch.</p>
      <div class="theme-controls" role="group" aria-label="Giao diện">
        <button type="button" data-theme="light" aria-label="Giao diện sáng" title="Trời sáng" aria-pressed="false">☀</button>
        <button type="button" data-theme="dark" aria-label="Giao diện tối" title="Trời tối" aria-pressed="false">☾</button>
        <button type="button" data-theme="system" aria-label="Theo cài đặt thiết bị" title="Theo thiết bị" aria-pressed="false">◐</button>
      </div>
    </div>
    <p class="template-credit">Dựng từ <a href="https://github.com/markhorn-dev/astro-nano" target="_blank" rel="noopener noreferrer">Astro Nano</a>, thêm chút mây của mình.</p>
  </Container>
</footer>
